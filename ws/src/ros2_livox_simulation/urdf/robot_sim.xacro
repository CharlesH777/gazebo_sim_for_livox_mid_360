<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="cube_robot">

  <!-- ================= 参数 ================= -->
  <xacro:property name="mass" value="5.0"/>
  <xacro:property name="size" value="0.4"/>
  <xacro:property name="body_height" value="${size/2}"/>

  <xacro:property name="wheel_radius" value="0.10"/>
  <xacro:property name="wheel_thickness" value="0.10"/>
  <xacro:property name="wheel_separation" value="0.40"/>
  <xacro:property name="wheelbase" value="0.35"/>
  <xacro:property name="axle_height" value="${wheel_radius + 0.03}"/>

  <!-- ================= base_footprint ================= -->
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 ${axle_height}" rpy="0 0 0"/>
  </joint>

  <!-- ================= base_link ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${size} ${size} ${body_height}"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${size} ${size} ${body_height}"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 ${body_height/2}" rpy="0 0 0"/>
      <mass value="${mass}"/>
      <inertia
        ixx="0.02" iyy="0.02" izz="0.02"
        ixy="0.0" ixz="0.0" iyz="0.0"/>
    </inertial>
  </link>

  <!-- ================= 轮子宏 ================= -->
  <xacro:macro name="wheel_link" params="name">
    <link name="${name}">
      <visual>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="1.5708 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.3"/>
        <inertia
          ixx="0.001" iyy="0.001" izz="0.001"
          ixy="0.0" ixz="0.0" iyz="0.0"/>
      </inertial>
    </link>
  </xacro:macro>

  <xacro:macro name="wheel_joint" params="joint parent child x y">
    <joint name="${joint}" type="continuous">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${x} ${y} 0" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
      <dynamics damping="0.2" friction="0.1"/>
    </joint>
  </xacro:macro>

  <!-- ================= 四轮 ================= -->
  <xacro:wheel_link name="left_front_wheel"/>
  <xacro:wheel_link name="right_front_wheel"/>
  <xacro:wheel_link name="left_rear_wheel"/>
  <xacro:wheel_link name="right_rear_wheel"/>

  <xacro:wheel_joint joint="left_front_wheel_joint"
                     parent="base_link" child="left_front_wheel"
                     x="${wheelbase/2}" y="${wheel_separation/2}"/>

  <xacro:wheel_joint joint="right_front_wheel_joint"
                     parent="base_link" child="right_front_wheel"
                     x="${wheelbase/2}" y="-${wheel_separation/2}"/>

  <xacro:wheel_joint joint="left_rear_wheel_joint"
                     parent="base_link" child="left_rear_wheel"
                     x="-${wheelbase/2}" y="${wheel_separation/2}"/>

  <xacro:wheel_joint joint="right_rear_wheel_joint"
                     parent="base_link" child="right_rear_wheel"
                     x="-${wheelbase/2}" y="-${wheel_separation/2}"/>

  <!-- ================= Livox 雷达 ================= -->
  <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro"/>

  <!-- 虚拟安装座：用于悬空 + 俯仰旋转 30° -->
  <link name="livox_mount_link"/>

  <joint name="livox_mount_joint" type="fixed">
    <parent link="base_link"/>
    <child link="livox_mount_link"/>
    <origin xyz="0 0 ${size}" rpy="0 -0.523599 0"/>
  </joint>

  <xacro:mid360 name="livox" parent="livox_mount_link" topic="livox/lidar">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:mid360>

  <!-- ================= IMU ================= -->
  <xacro:property name="imu_x" value="0.006253"/>
  <xacro:property name="imu_y" value="-0.011775"/>
  <xacro:property name="imu_z" value="0.007645"/>

  <link name="imu_link">
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.05"/>
      <inertia ixx="1e-5" iyy="1e-5" izz="1e-5"
               ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <origin xyz="${imu_x} ${imu_y} ${imu_z}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>300.0</update_rate>
      <imu>
        <angular_velocity>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.0002</stddev>
          </noise>
        </angular_velocity>
        <linear_acceleration>
          <noise type="gaussian">
            <mean>0.0</mean>
            <stddev>0.01</stddev>
          </noise>
        </linear_acceleration>
      </imu>

      <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
        <ros>
          <namespace>/</namespace>
          <remapping>~/out:=/livox/imu</remapping>
        </ros>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- ================= ros2_control ================= -->
  <ros2_control name="GazeboSystem" type="system">
    <hardware>
      <plugin>gazebo_ros2_control/GazeboSystem</plugin>
    </hardware>

    <joint name="left_front_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_front_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="left_rear_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>

    <joint name="right_rear_wheel_joint">
      <command_interface name="velocity"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
    </joint>
  </ros2_control>

  <!-- ================= gazebo_ros2_control 插件 ================= -->
  <gazebo>
    <plugin name="gazebo_ros2_control"
            filename="libgazebo_ros2_control.so">
      <robot_param>robot_description</robot_param>
      <robot_param_node>robot_state_publisher</robot_param_node>
      <parameters>$(find ros2_livox_simulation)/config/cube_rob_cotrl.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================= world pose TF publisher（新增） ================= -->
  <gazebo>
    <plugin name="tf_pub" filename="libtf_pub.so"/>
  </gazebo>

</robot>
